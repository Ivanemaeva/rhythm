# Copy this file to .env and fill in your own values. Never commit .env.

# Household timezone for all baseline grouping and display (IANA name)
HOUSEHOLD_TIMEZONE=Europe/Rome

# Morning rule configuration
LEARNING_DAYS=14
BASELINE_DAYS=56
# Events before this local time never count as the first activity of the day
MORNING_START=05:00
# Minutes to wait after the cutoff before a silent-morning alert (Ring events can arrive late)
ALERT_GRACE_MINUTES=10
# Report "lost connection to Ring" if no successful Ring contact for this many minutes
RING_STALE_MINUTES=30
MIN_SAMPLES_PER_BUCKET=5
MAX_MARGIN_MINUTES=15
MIN_WAIT_WEEKDAY=10:00
MIN_WAIT_WEEKEND=11:00
# Fixed conservative cutoffs used until a weekday/weekend bucket has enough samples
FALLBACK_WEEKDAY=10:00
FALLBACK_WEEKEND=11:00

# Ring Partner API. A Developer Playground token lasts about 30 minutes.
RING_API_BASE_URL=https://api.amazonvision.com
RING_ACCESS_TOKEN=
# Leave blank to discover and sync all account devices; set to pin one device.
RING_DEVICE_ID=
# poll = scripts call the Ring API; webhook = Ring calls POST /webhooks/ring
RING_INGESTION_MODE=poll
RING_POLL_SECONDS=120
RING_WEBHOOK_SECRET=

# Local SQLite store
DATABASE_PATH=data/rhythm.sqlite3

# Protects dashboard/admin APIs. Required when webhook mode or a public reply-link URL is used.
# Open the dashboard as http://127.0.0.1:8000/?token=THIS_VALUE
RHYTHM_ADMIN_TOKEN=

# Origin used in signed email reply links (localhost for laptop testing;
# use your HTTPS tunnel URL when clicking from a phone).
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Generate a private random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
REPLY_TOKEN_SECRET=

# Email delivery (SMTP). For Gmail use an app password, not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_TO=
SMTP_USE_STARTTLS=true
